import numpy as np, pandas as pd, yfinance as yf, math, sys, warnings, io, urllib.request
from datetime import datetime, timedelta
import matplotlib.pyplot as plt
warnings.filterwarnings("ignore")

# ------------------------------ config ------------------------------
LOOKBACK_YEARS        = 5
REBALANCE_EVERY_DAYS  = 1
VOL_WINDOW_DAYS       = 40
TARGET_ANNUAL_VOL     = 1.0
RISK_FREE_ANNUAL      = 0.03
TOP_N_LONG            = 45
TOP_N_SHORT           = 5
MAX_W_PER_NAME_LONG   = 0.08
MAX_W_PER_NAME_SHORT  = 0.02
LONG_GROSS            = 1.10
SHORT_GROSS           = 0.40
MARKET_NEUTRAL        = False

# ------------------------------ helpers ------------------------------
def ema(s, span): return s.ewm(span=span, adjust=False).mean()

def rsi(series, period=14):
    d = series.diff()
    up, dn = d.clip(lower=0), -d.clip(upper=0)
    ru = up.ewm(alpha=1/period, adjust=False).mean()
    rd = dn.ewm(alpha=1/period, adjust=False).mean()
    rs = ru/(rd+1e-12)
    return 100 - (100/(1+rs))

def macd_hist(series, fast=12, slow=26, signal=9):
    ef, es = ema(series, fast), ema(series, slow)
    line = ef - es
    return line - ema(line, signal)

def zscore(x: pd.Series) -> pd.Series:
    out = (x - x.mean()) / (x.std() + 1e-12)
    return out.replace([np.inf,-np.inf], 0).fillna(0)

def perf_metrics(r: pd.Series, rf_annual=RISK_FREE_ANNUAL):
    r = r.dropna()
    if r.empty:
        return dict(days=0, vol=0, sharpe=0, sortino=0, cagr=0, maxdd=0, calmar=0)
    ann = 252
    mu = r.mean()*ann
    vol = r.std()*math.sqrt(ann)
    dvol = r[r<0].std()*math.sqrt(ann)
    sharpe = (mu - rf_annual)/(vol + 1e-12)
    sortino= (mu - rf_annual)/(dvol + 1e-12)
    eq = (1+r).cumprod()
    peak = eq.cummax()
    dd = (eq/peak - 1.0)
    maxdd = float(dd.min())
    years = len(r)/ann
    cagr = eq.iloc[-1]**(1/years)-1 if years>0 else 0
    calmar = cagr/abs(maxdd) if maxdd<0 else np.nan
    return dict(days=len(r), vol=vol, sharpe=sharpe, sortino=sortino, cagr=cagr, maxdd=maxdd, calmar=calmar)

# ------------------------------ robust S&P 500 tickers ------------------------------
def load_sp500_tickers():
    urls = [
        ("wiki",
         "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies"),
        ("github",
         "https://raw.githubusercontent.com/datasets/s-and-p-500-companies/master/data/constituents.csv"),
    ]
    ua = {"User-Agent":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Safari/537.36"}
    # try Wikipedia with headers
    try:
        tbls = pd.read_html(urls[0][1], storage_options=ua)
        df = tbls[0]
        syms = df['Symbol'].astype(str).str.replace('.', '-', regex=False).tolist()
        if len(syms) >= 400:
            return sorted(set(syms))
    except Exception as e:
        print("Wiki fetch failed →", type(e).__name__)
    # try GitHub CSV
    try:
        req = urllib.request.Request(urls[1][1], headers=ua)
        with urllib.request.urlopen(req, timeout=15) as r:
            raw = r.read()
        df = pd.read_csv(io.BytesIO(raw))
        col = 'Symbol' if 'Symbol' in df.columns else ('symbol' if 'symbol' in df.columns else df.columns[0])
        syms = df[col].astype(str).str.replace('.', '-', regex=False).tolist()
        if len(syms) >= 400:
            return sorted(set(syms))
    except Exception as e:
        print("GitHub fetch failed →", type(e).__name__)
    # tiny fallback set (enough to run the code)
    fallback = [
        "AAPL","MSFT","NVDA","AMZN","META","GOOGL","GOOG","BRK-B","JPM","V","MA","HD","LLY","XOM",
        "UNH","PG","AVGO","COST","ADBE","PEP","CSCO","NFLX","CRM","ABBV","KO","MRK","MCD","WMT","AMD","LIN",
    ]
    print("Using small built-in fallback list ({} tickers).".format(len(fallback)))
    return fallback

tickers = load_sp500_tickers()
print(f"Tickers loaded: {len(tickers)}")

# ------------------------------ data ------------------------------
end = datetime.utcnow()
start = end - timedelta(days=int(365*LOOKBACK_YEARS*1.05))
data = yf.download(tickers, start=start, end=end, interval="1d", auto_adjust=True, progress=False, group_by="ticker")

def get_panel(field):
    if isinstance(data.columns, pd.MultiIndex):
        cols = {}
        for t in tickers:
            try:
                cols[t] = data[t][field].rename(t)
            except Exception:
                pass
        return pd.DataFrame(cols).sort_index()
    else:
        return data[field].sort_index()

C = get_panel("Close").ffill()
H = get_panel("High").reindex(C.index).ffill()[C.columns]
L = get_panel("Low").reindex(C.index).ffill()[C.columns]

# drop names without enough history
min_days = 250
have = [t for t in C.columns if C[t].dropna().shape[0] >= min_days]
C, H, L = C[have], H[have], L[have]
assert not C.empty, "No price data available."

# ------------------------------ signals ------------------------------
rets   = C.pct_change()
mom6_1 = C.pct_change(126).shift(21)
sma50  = C.rolling(50).mean()
sma200 = C.rolling(200).mean()
dist50 = (C - sma50)/(sma50+1e-12)
dist200= (C - sma200)/(sma200+1e-12)
macdh  = C.apply(macd_hist)
rsi14  = C.apply(rsi)
rsi_pref = -((rsi14 - 55.0).abs())
vol20  = rets.rolling(VOL_WINDOW_DAYS).std() * np.sqrt(252)

last = C.index[-1]
s_mom   = zscore(mom6_1.loc[last])
s_d200  = zscore(dist200.loc[last])
s_d50   = zscore(dist50.loc[last])
s_macd  = zscore(macdh.loc[last])
s_rsi   = zscore(rsi_pref.loc[last])
s_vol   = zscore(vol20.loc[last])

score = (
    0.20*s_mom + 0.20*s_d200 + 0.20*s_d50 + 0.20*s_macd + 0.20*s_rsi - 0.15*s_vol
).dropna().sort_values(ascending=False)

# ------------------------------ selection + trend filter ------------------------------
cands_long  = list(score.index[:TOP_N_LONG])
cands_short = list(score.index[::-1][:TOP_N_SHORT])

live_close = C.loc[last]
long_names  = [t for t in cands_long  if live_close.get(t, np.nan) > sma200.loc[last].get(t, np.nan)]
short_names = [t for t in cands_short if live_close.get(t, np.nan) < sma200.loc[last].get(t, np.nan)]

# ------------------------------ weights ------------------------------
def realized_vol_today(px: pd.DataFrame, window=VOL_WINDOW_DAYS) -> pd.Series:
    return px.pct_change().rolling(window).std().iloc[-1]*np.sqrt(252)

ivol = (1.0 / realized_vol_today(C)).replace([np.inf,-np.inf], np.nan)
ivol = ivol.fillna(ivol.median())

def inv_vol_weights(names, cap, gross):
    if not names: return pd.Series(dtype=float)
    w = ivol.reindex(names).fillna(0)
    if w.sum() <= 0:
        w = pd.Series(1/len(names), index=names)
    else:
        w = w / w.sum()
    w = w.clip(upper=cap)
    w = w * (gross / (w.sum() + 1e-12))
    return w

wL = inv_vol_weights(long_names,  MAX_W_PER_NAME_LONG,  LONG_GROSS)
wS = inv_vol_weights(short_names, MAX_W_PER_NAME_SHORT, SHORT_GROSS) * -1.0
weights_live = (wL.add(wS, fill_value=0)).reindex(C.columns).fillna(0)

if MARKET_NEUTRAL:
    lg = float(weights_live.clip(lower=0).sum())
    sg = float((-weights_live.clip(upper=0)).sum())
    if lg>1e-9 and sg>1e-9:
        scale = lg/sg
        weights_live[weights_live<0] *= scale

# ------------------------------ backtest (proxy) ------------------------------
rets = C.pct_change().fillna(0)
port_r = (rets * weights_live).sum(axis=1)

# vol targeting
realized_vol_ann = port_r.std()*np.sqrt(252)
scale_vt = (TARGET_ANNUAL_VOL / realized_vol_ann) if realized_vol_ann>1e-8 else 1.0
port_r_vt = port_r * max(0.4, min(1.8, scale_vt))

metrics = perf_metrics(port_r_vt, RISK_FREE_ANNUAL)

print(f"Universe: {len(C.columns)} | Longs: {len(long_names)} | Shorts: {len(short_names)}")
print("Top longs:", long_names[:10])
print("Top shorts:", short_names[:10])
print(f"\nDays: {metrics['days']}")
print(f"Ann Vol: {metrics['vol']*100:5.2f}%")
print(f"Sharpe: {metrics['sharpe']:.2f}")
print(f"Sortino: {metrics['sortino']:.2f}")
print(f"CAGR: {metrics['cagr']*100:5.2f}%")
print(f"MaxDD: {metrics['maxdd']*100:5.2f}%")
print(f"Calmar: {metrics['calmar']:.2f}")

# ------------------------------ plot ------------------------------
eq = (1+port_r_vt).cumprod()
plt.figure(figsize=(10,5))
plt.plot(eq.index, eq.values, label="Equity")
plt.title("S&P 500 L/S Strategy — Equity Curve")
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()
